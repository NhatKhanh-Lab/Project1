<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Green Age</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/nivo-slider.css">
</head>
<body class="homepage">
  <div id="tooplate_wrapper">
    <div id="tooplate_header">
      <div id="site_title">
        <h1><a href="/">Green Age</a></h1>
        <p class="site_tagline">Landscape ideas, eco design, and brighter outdoor living.</p>
      </div>

      <div class="header_intro">
        <span class="header_badge">Machine A</span>
        <p>Round 1 focuses only on the homepage header and brand logo.</p>
        <a href="/" class="header_link">Green Age Homepage</a>
      </div>
      <div class="cleaner"></div>
    </div>

    <div id="tooplate_menu">
      <ul>
        <li><a href="/" class="current">Home</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#about">About</a></li>
        <li class="last"><a href="#contact">Contact</a></li>
      </ul>

      <div id="search_box">
        <form action="#" method="get">
          <input type="text" value="Search green ideas" name="q" size="10" id="searchfield" title="searchfield">
          <input type="submit" name="Search" value="" id="searchbutton" title="Search">
        </form>
      </div>

      <div class="cleaner"></div>
    </div>

    <div class="menu_note">
      <span>Machine A added the homepage menu and quick search.</span>
      <a href="#projects">Browse recent outdoor projects</a>
    </div>

    <section id="home_banner">
      <div class="banner_head">
        <span class="banner_badge">Machine B</span>
        <h2>Homepage Slider Banner</h2>
      </div>
      <div class="banner_track">
        <div class="banner_card">
          <img src="/images/slideshow/01.jpg" alt="Garden pathway design">
          <p>Modern pathways for greener outdoor spaces.</p>
        </div>
        <div class="banner_card">
          <img src="/images/slideshow/02.jpg" alt="Front yard landscape">
          <p>Curated front-yard ideas with natural textures.</p>
        </div>
        <div class="banner_card">
          <img src="/images/slideshow/03.jpg" alt="Backyard eco style">
          <p>Eco-focused backyard layouts for daily comfort.</p>
        </div>
      </div>
    </section>

    <section id="welcome_section">
      <div class="welcome_text">
        <span class="welcome_badge">Machine B</span>
        <h2>Welcome to Green Age Studio</h2>
        <p>
          We design calm, sustainable landscapes with practical layouts, natural
          materials, and long-term maintenance in mind.
        </p>
        <a href="#about" class="more">Read More</a>
      </div>
      <div class="welcome_image">
        <img src="/images/tooplate_image_01.jpg" alt="Landscape planning team at work">
      </div>
      <div class="cleaner"></div>
    </section>
  </div>

  <div id="tooplate_cr_wrapper">
    <div id="tooplate_cr">
      <div class="footer_columns">
        <div class="footer_block">
          <h4>Green Age Studio</h4>
          <p>Eco-minded landscape concepts for homes, cafes, and urban outdoor spaces.</p>
        </div>
        <div class="footer_block">
          <h4>Quick Links</h4>
          <a href="/">Home</a>
          <a href="#services">Services</a>
          <a href="#projects">Projects</a>
        </div>
        <div class="footer_block" id="contact">
          <h4>Contact</h4>
          <p>Hotline: 0123 456 789</p>
          <p>Email: hello@greenage.vn</p>
          <p>Address: 2031 Green Avenue, Garden District</p>
        </div>
      </div>
      <p class="footer_copy">Copyright 2026 <a href="#">Green Age Team Project</a> | Footer completed by Machine A.</p>
    </div>
  </div>
</body>
</html>

